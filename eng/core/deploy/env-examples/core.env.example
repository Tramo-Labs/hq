# Copy to deploy/core.env on the server (chmod 600). Never commit it.
# Used by api and worker. No ARCA_CERT or ARCA_KEY here, ever.
APP_ENV=staging
ARCA_ENV=homologacion
# Runtime role: cannot touch a table except through tramo_app / tramo_system.
DATABASE_URL=postgres://tramo_runtime:replace-me@postgres:5432/tramo?sslmode=disable
# openssl rand -base64 32 (each)
MASTER_KEY=replace-me
JWT_SIGNING_KEY=replace-me
JWT_KEY_ID=k1
