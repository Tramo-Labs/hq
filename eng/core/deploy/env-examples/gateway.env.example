# Copy to deploy/gateway.env on the server (chmod 600). Never commit it.
# Only the arca-gateway container reads this file.
ARCA_ENV=homologacion
ARCA_CUIT=replace-with-tramo-cuit
# PEM text of the certificate from WSASS (homologacion) or the certificate
# administration of ARCA (produccion), and its private key. Multi line
# values: quote them, or load them from a secrets manager.
ARCA_CERT="-----replace with the PEM certificate-----"
ARCA_KEY="-----replace with the PEM private key-----"
