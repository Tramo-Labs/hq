# Copy to deploy/postgres.env on the server (chmod 600). Never commit it.
# Generate passwords with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-me
TRAMO_RUNTIME_PASSWORD=replace-me
# Privileged URL for the one-shot migrate step only.
MIGRATE_DATABASE_URL=postgres://tramo_owner:replace-me@postgres:5432/tramo?sslmode=disable
